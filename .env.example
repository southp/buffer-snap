# Copy to .env and fill in. .env is gitignored. Never commit these values.
# Worktrees inside this checkout use the same .env: `just` looks for it in parent folders too.
# A variable already set in the environment (as on CI) wins over this file.

# developer.apple.com → Account → Membership details
DEVELOPMENT_TEAM=

# App Store Connect → Users and Access → Integrations → Team Keys (Admin role)
ASC_KEY_ID=
ASC_ISSUER_ID=

# Optional. Defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH=
